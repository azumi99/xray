  "scripts": {
    "start": "expo start",
    "postinstall": "patch-package",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test:e2e:android:build": "detox build --configuration android.emu.debug",
    "test:e2e:android:test": "detox test --configuration android.emu.debug",
    "test:e2e:android": "npm run test:e2e:android:build && npm run test:e2e:android:test",
    "test:e2e:ios:build": "detox build --configuration ios.sim.debug",
    "test:e2e:ios:test": "detox test --configuration ios.sim.debug",
    "test:e2e:ios": "npm run test:e2e:ios:build && npm run test:e2e:ios:test"
  },
