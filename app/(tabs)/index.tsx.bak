// Removed GluestackCard import as it's not used in the component
import { MaterialCommunityIcons } from "@expo/vector-icons";
import {
  Box,
  Button,
  ButtonText,
  Card,
  HStack,
  Pressable,
  Text,
  VStack,
} from "@gluestack-ui/themed";
import { Link } from "expo-router";
import { useEffect, useState } from "react";
import { Alert, SafeAreaView, ScrollView } from "react-native";
import { useLogout } from "../../lib/utils/logout";

const operationItems = [
  {
    id: 1,
    link: "/(tabs)/inbound",
    icon: "arrow-down-bold-outline",
    title: "Inbound",
    subtitle: "Receiving",
  },
  {
    id: 2,
    link: "/(tabs)/outbound",
    icon: "arrow-up-bold-outline",
    title: "Outbound",
    subtitle: "Shipping",
  },
  {
    id: 3,
    link: "/(tabs)/putaway",
    icon: "tray-arrow-down",
    title: "Putaway",
    subtitle: "Storage",
  },
  {
    id: 4,
    link: "/inventory",
    icon: "package-variant-closed",
    title: "Inventory",
    subtitle: "Items List",
  },
  {
    id: 5,
    link: "/(tabs)/stock",
    icon: "clipboard-list-outline",
    title: "Stock",
    subtitle: "Counting",
  },
  {
    id: 6,
    link: "/delivery",
    icon: "truck-fast",
    title: "Delivery",
    subtitle: "Analytics",
  },
  {
    id: 7,
    link: "/movement",
    icon: "cursor-move",
    title: "Movement",
    subtitle: "Transfer",
  },
  {
    id: 8,
    link: "/picking",
    icon: "boxing-glove",
    title: "Picking",
    subtitle: "Orders",
  },
  {
    id: 9,
    link: "/cycle",
    icon: "refresh",
    title: "Cycle",
    subtitle: "Count",
  },
  {
    id: 10,
    link: "/pickingMulti",
    icon: "format-list-numbered",
    title: "Multi Pick",
    subtitle: "Bulk",
  },
];

const statItems = [
  { id: 1, value: 24, label: "Tasks Today", color: "$primary500" },
  { id: 2, value: 12, label: "Completed", color: "$success500" },
  { id: 3, value: 12, label: "Pending", color: "$warning500" },
  {
    id: 4,
    value: 85,
    label: "Efficiency",
    color: "$secondary500",
    suffix: "%",
  },
];

HomeScreen.options = { headerShown: false };

export default function HomeScreen() {
  const [countdownEnd, setCountdownEnd] = useState(new Date());
  const { handleLogout } = useLogout();

  useEffect(() => {
    const t = new Date();
    t.setHours(t.getHours() + 1);
    setCountdownEnd(t);
  }, []);

  const handleLogoutPress = () => {
    Alert.alert(
      "Konfirmasi Logout",
      "Apakah Anda yakin ingin keluar dari aplikasi?",
      [
        { text: "Batal", style: "cancel" },
        {
          text: "Ya, Keluar",
          style: "destructive",
          onPress: async () => {
            try {
              const result = await handleLogout();
              if (!result.success)
                Alert.alert("Error", "Terjadi kesalahan saat logout.");
            } catch (e) {
              console.error("Logout error:", e);
              Alert.alert("Error", "Terjadi kesalahan saat logout.");
            }
          },
        },
      ],
      { cancelable: true }
    );
  };

  const renderOperationItem = ({
    item,
  }: {
    item: (typeof operationItems)[number];
  }) => (
    <Link href={item.link} asChild>
      <Pressable $activeOpacity={0.8} flex={1} my="$1">
        {({ pressed }) => (
          <Card
            bg="$white"
            borderRadius="$2xl"
            p="$5"
            alignItems="center"
            justifyContent="center"
            space="$3"
            shadowColor="$backgroundLight500"
            shadowOffset={{ width: 0, height: 2 }}
            shadowOpacity={0.1}
            shadowRadius={4}
            opacity={pressed ? 0.8 : 1}
            flex={1}
            borderWidth={1}
            borderColor="$borderLight100"
          >
            <MaterialCommunityIcons
              name={item.icon}
              size={28}
              color="$primary600"
            />
            <VStack alignItems="center" space="$2">
              <Text
                fontSize="$xs"
                fontWeight="$bold"
                color="$text900"
                textAlign="center"
              >
                {item.title}
              </Text>
              <Text fontSize="$xs" color="$text500" textAlign="center">
                {item.subtitle}
              </Text>
            </VStack>
          </Card>
        )}
      </Pressable>
    </Link>
  );

  const renderStatItem = ({ item }: { item: (typeof statItems)[number] }) => (
    <Card
      bg="$white"
      borderRadius="$2xl"
      p="$5"
      alignItems="center"
      justifyContent="center"
      shadowColor="$backgroundLight500"
      shadowOffset={{ width: 0, height: 2 }}
      shadowOpacity={0.1}
      shadowRadius={4}
      flex={1}
      my="$1"
    >
      <Box
        w="$16"
        h="$16"
        borderRadius="$full"
        bg={item.color + "20"}
        borderWidth={3}
        borderColor={item.color as any}
        alignItems="center"
        justifyContent="center"
        mb="$3"
      >
        <Text fontSize="$xl" fontWeight="$bold" color={item.color as any}>
          {item.value}
          {item.suffix || ""}
        </Text>
      </Box>
      <Text
        fontSize="$sm"
        fontWeight="$semibold"
        color="$text800"
        textAlign="center"
      >
        {item.label}
      </Text>
    </Card>
  );

  return (
    <SafeAreaView flex={1} bg="$primary50">
      <ScrollView
        showsVerticalScrollIndicator={false}
        flex={1}
        contentContainerStyle={{ flexGrow: 1 }}
      >
        {/* Header Section with Gradient-like Background */}
        <VStack px="$6" pt="$6" pb="$8" bg="$primary600">
          <HStack justifyContent="space-between" alignItems="center">
            <VStack flex={1} mr="$4">
              <Text fontSize="$2xl" fontWeight="$bold" color="$white" mb="$1">
                Welcome Back! 👋
              </Text>
              <Text fontSize="$md" color="$primary100" opacity={0.9}>
                Here's what's happening today
              </Text>
            </VStack>
            <Button
              size="sm"
              variant="outline"
              action="secondary"
              onPress={handleLogoutPress}
              bg="$white"
              borderColor="$white"
              borderRadius="$full"
              px="$4"
              minWidth={80}
            >
              <ButtonText
                color="$primary600"
                fontWeight="$semibold"
                fontSize="$xs"
              >
                Logout
              </ButtonText>
            </Button>
          </HStack>
        </VStack>

        {/* Main Content Area */}
        <VStack
          px="$6"
          pt="$6"
          pb="$6"
          space="$5"
          flex={1}
          bg="$backgroundLight0"
          borderTopLeftRadius="$3xl"
          borderTopRightRadius="$3xl"
          minHeight="100%"
        >
          {/* Operations Section */}
          <VStack space="$4">
            <Text fontSize="$xl" fontWeight="$bold" color="$text900" mb="$3">
              Operations
            </Text>
            <VStack space="$4">
              {/* Create rows with 3 items each */}
              {Array.from({ length: Math.ceil(operationItems.length / 3) }).map(
                (_, rowIndex) => {
                  const start = rowIndex * 3;
                  const rowItems = operationItems.slice(start, start + 3);
                  return (
                    <HStack
                      key={rowIndex}
                      space="$3"
                      justifyContent="space-between"
                    >
                      {rowItems.map((item) => (
                        <Box key={item.id} flex={1} mx="$1">
                          {renderOperationItem({ item })}
                        </Box>
                      ))}
                    </HStack>
                  );
                }
              )}
            </VStack>
          </VStack>
        </VStack>
      </ScrollView>
    </SafeAreaView>
  );
}
