import React, { useState } from 'react';
import { View, Text, SafeAreaView, ScrollView, TouchableOpacity, Alert } from 'react-native';
import { VStack, FormControl, Input, InputField, Button, Box, HStack, Avatar, AvatarFallbackText, LinearGradient, Badge } from '@gluestack-ui/themed';
import { UserIcon, ShieldIcon, LogOutIcon, KeyIcon, SettingsIcon, HelpCircleIcon, ChevronRightIcon } from 'lucide-react-native';
import { useRouter } from 'expo-router';
import { sessionStorage } from '@/services/storage';

const ProfileScreen = () => {
  const [oldPassword, setOldPassword] = useState('');
  const [newPassword, setNewPassword] = useState('');
  const router = useRouter();

  const handleLogout = async () => {
    Alert.alert(
      'Confirm Logout',
      'Are you sure you want to logout?',
      [
        {
          text: 'Cancel',
          style: 'cancel',
        },
        {
          text: 'Logout',
          style: 'destructive',
          onPress: async () => {
            await sessionStorage.removeSession();
            router.replace('/(auth)/login');
          },
        },
      ]
    );
  };

  const handleChangePassword = () => {
    Alert.alert('Success', 'Password updated successfully (dummy)');
    setOldPassword('');
    setNewPassword('');
  };

  const menuItems = [
    {
      icon: SettingsIcon,
      label: 'Settings',
      onPress: () => console.log('Settings pressed'),
      color: '#6B7280',
    },
    {
      icon: HelpCircleIcon,
      label: 'Help & Support',
      onPress: () => console.log('Help pressed'),
      color: '#6B7280',
    },
  ];

  return (
    <Box flex={1} bg="$background0">
      <LinearGradient
        colors={['#F0F9FF', '#FFFFFF']}
        style={{ position: 'absolute', top: 0, left: 0, right: 0, height: 200 }}
      />
      <SafeAreaView style={{ flex: 1 }}>
        <ScrollView contentContainerStyle={{ paddingBottom: 120 }}>
          <VStack p="lg" pt="xl" space="lg">
            {/* Enhanced Header */}
            <VStack alignItems="center" mb="xl">
              <Box
                position="relative"
                mb="md"
              >
                <Avatar
                  size="2xl"
                  bg="$primary600"
                  borderWidth={3}
                  borderColor="$background0"
                  style={styles.avatar}
                >
                  <AvatarFallbackText fontSize="$3xl" fontWeight="$bold">
                    JD
                  </AvatarFallbackText>
                </Avatar>
                <Box
                  position="absolute"
                  bottom={4}
                  right={4}
                  w="$5"
                  h="$5"
                  borderRadius="$full"
                  bg="$success500"
                  borderWidth={2}
                  borderColor="$background0"
                />
              </Box>

              <VStack alignItems="center" space="xs">
                <Text fontSize="$2xl" fontWeight="$bold" color="$text0">
                  John Doe
                </Text>
                <Text fontSize="$md" color="$text400" textAlign="center">
                  john.doe@example.com
                </Text>
                <Badge
                  bg="$success100"
                  px="$3"
                  py="$1"
                  borderRadius="$full"
                  mt="$2"
                >
                  <Text color="$success600" fontWeight="$600" fontSize="$sm">
                    Active
                  </Text>
                </Badge>
              </VStack>
            </VStack>

            {/* Quick Stats */}
            <HStack justifyContent="space-around" mb="lg" p="md" bg="rgba(255,255,255,0.8)" borderRadius="$2xl">
              <VStack alignItems="center">
                <Text fontSize="$2xl" fontWeight="$bold" color="$primary600">24</Text>
                <Text fontSize="$xs" color="$text400">Total AWB</Text>
              </VStack>
              <Box width={1} height="full" bg="$background200" />
              <VStack alignItems="center">
                <Text fontSize="$2xl" fontWeight="$bold" color="$success600">18</Text>
                <Text fontSize="$xs" color="$text400">Completed</Text>
              </VStack>
              <Box width={1} height="full" bg="$background200" />
              <VStack alignItems="center">
                <Text fontSize="$2xl" fontWeight="$bold" color="$warning600">6</Text>
                <Text fontSize="$xs" color="$text400">In Progress</Text>
              </VStack>
            </HStack>

            {/* Menu Items */}
            <Box bg="$background0" borderRadius="$2xl" p="$2" shadow="$1">
              {menuItems.map((item, index) => {
                const IconComponent = item.icon;
                return (
                  <TouchableOpacity
                    key={index}
                    onPress={item.onPress}
                    style={styles.menuItem}
                    activeOpacity={0.7}
                  >
                    <HStack alignItems="center" space="md" p="md">
                      <Box
                        w="$10"
                        h="$10"
                        borderRadius="$lg"
                        bg="$background100"
                        alignItems="center"
                        justifyContent="center"
                      >
                        <IconComponent size={18} color={item.color} />
                      </Box>
                      <Text fontSize="$md" color="$text0" flex={1}>
                        {item.label}
                      </Text>
                      <ChevronRightIcon size={16} color="#D1D5DB" />
                    </HStack>
                    {index < menuItems.length - 1 && (
                      <Box ml="auto" w="80%" h={1} bg="$background100" />
                    )}
                  </TouchableOpacity>
                );
              })}
            </Box>

            {/* Security Section */}
            <Box bg="$background0" borderRadius="$2xl" p="lg" shadow="$1">
              <HStack alignItems="center" space="sm" mb="md">
                <Box
                  w="$10"
                  h="$10"
                  borderRadius="$lg"
                  bg="$primary50"
                  alignItems="center"
                  justifyContent="center"
                >
                  <ShieldIcon size={20} color="#0284C7" />
                </Box>
                <VStack flex={1}>
                  <Text fontWeight="$600" fontSize="$lg" color="$text0">
                    Security
                  </Text>
                  <Text fontSize="$sm" color="$text400">
                    Manage your password and security settings
                  </Text>
                </VStack>
              </HStack>

              <VStack space="md">
                <FormControl>
                  <Input
                    borderRadius="$2xl"
                    borderColor="$background200"
                    borderWidth={1}
                    py="sm"
                    px="md"
                    bg="$background50"
                  >
                    <InputField
                      placeholder="Current Password"
                      value={oldPassword}
                      onChangeText={setOldPassword}
                      secureTextEntry
                      color="$text0"
                      fontSize="$md"
                    />
                  </Input>
                </FormControl>

                <FormControl>
                  <Input
                    borderRadius="$2xl"
                    borderColor="$background200"
                    borderWidth={1}
                    py="sm"
                    px="md"
                    bg="$background50"
                  >
                    <InputField
                      placeholder="New Password"
                      value={newPassword}
                      onChangeText={setNewPassword}
                      secureTextEntry
                      color="$text0"
                      fontSize="$md"
                    />
                  </Input>
                </FormControl>

                <Button
                  size="md"
                  variant="solid"
                  bg="$primary600"
                  borderRadius="$2xl"
                  py="sm"
                  onPress={handleChangePassword}
                  shadow="$2"
                  _pressed={{ bg: "$primary700" }}
                  style={styles.button}
                >
                  <HStack alignItems="center" space="sm">
                    <KeyIcon size={18} color="white" />
                    <Text color="white" fontWeight="$600" fontSize="$md">
                      Update Password
                    </Text>
                  </HStack>
                </Button>
              </VStack>
            </Box>

            {/* Logout Section */}
            <Box bg="$background0" borderRadius="$2xl" p="lg" shadow="$1">
              <Button
                variant="outline"
                action="negative"
                borderRadius="$2xl"
                py="sm"
                onPress={handleLogout}
                borderWidth={1}
                borderColor="$red200"
                style={styles.button}
              >
                <HStack alignItems="center" space="sm">
                  <LogOutIcon size={18} color="#DC2626" />
                  <Text color="#DC2626" fontWeight="$600" fontSize="$md">
                    Logout
                  </Text>
                </HStack>
              </Button>
            </Box>
          </VStack>
        </ScrollView>
      </SafeAreaView>
    </Box>
  );
};

const styles = {
  avatar: {
    shadowColor: '#000',
    shadowOffset: { width: 0, height: 8 },
    shadowOpacity: 0.2,
    shadowRadius: 16,
    elevation: 8,
  },
  menuItem: {
    borderRadius: 12,
  },
  button: {
    shadowColor: '#000',
    shadowOffset: { width: 0, height: 2 },
    shadowOpacity: 0.1,
    shadowRadius: 4,
    elevation: 2,
  },
};

export default ProfileScreen;