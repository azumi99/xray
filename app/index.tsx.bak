import { useAuth } from "@/lib/store/auth";
import { router } from "expo-router";
import { useEffect } from "react";
import { Image } from "expo-image";
import {
  VStack,
  HStack,
  Text,
  Spinner,
  Box,
  Center
} from "@gluestack-ui/themed";
import { SafeAreaView } from "react-native";
import { PackageIcon } from "lucide-react-native";

export default function SplashScreen() {
  const { session, isLoading } = useAuth();

  console.log("session", session);

  useEffect(() => {
    if (!isLoading) {
      // If there's a session, redirect to the main app, otherwise to login
      if (session) {
          router.replace("/(tabs)/list");
      } else {
        router.replace("/(auth)/login");
      }
    }
  }, [session, isLoading]);

  // Show splash screen while loading auth state
  if (isLoading) {
    return (
      <SafeAreaView flex={1} bg="$primary600">
        <VStack
          flex={1}
          alignItems="center"
          justifyContent="center"
          px="lg"
          space="lg"
        >
          {/* Logo Container with Modern Gradient */}
          <Box
            w="$28"
            h="$28"
            borderRadius="$3xl"
            bg="linear-gradient(135deg, #4F46E5 0%, #7C3AED 100%)"
            alignItems="center"
            justifyContent="center"
            shadowColor="$black"
            shadowOffset={{ width: 0, height: 8 }}
            shadowOpacity={0.3}
            shadowRadius={12}
          >
            <PackageIcon size={64} color="white" />
          </Box>

          {/* App Title */}
          <VStack alignItems="center" space="$2">
            <Text
              fontSize="$5xl"
              fontWeight="$bold"
              color="$white"
              textAlign="center"
              letterSpacing={2}
            >
              AWB Mobile
            </Text>
            <Text
              fontSize="$md"
              color="$primary100"
              textAlign="center"
              fontWeight="$medium"
              opacity={0.9}
            >
              Track & Capture Airwaybills Easily
            </Text>
          </VStack>

          {/* Loading Section */}
          <VStack alignItems="center" space="$4">
            <Spinner size="large" color="$white" />
            <Text
              fontSize="$sm"
              color="$primary100"
              textAlign="center"
              opacity={0.8}
            >
              Initializing system...
            </Text>
          </VStack>

          {/* Decorative Elements */}
          <HStack space="$2" opacity={0.6}>
            <Box w="$2" h="$2" borderRadius="$full" bg="$white" />
            <Box w="$2" h="$2" borderRadius="$full" bg="$white" opacity={0.8} />
            <Box w="$2" h="$2" borderRadius="$full" bg="$white" />
          </HStack>

          {/* Version Info */}
          <VStack alignItems="center" space="sm" mt="auto">
            <Text
              fontSize="$xs"
              color="$primary100"
              textAlign="center"
              opacity={0.7}
            >
              v1.0 · UI Only Mode
            </Text>
            <Text
              fontSize="$xs"
              color="$primary100"
              textAlign="center"
              opacity={0.5}
            >
              © 2025 AWB Mobile
            </Text>
          </VStack>
        </VStack>
      </SafeAreaView>
    );
  }

  // Return null or a minimal view while redirecting
  return null;
}
