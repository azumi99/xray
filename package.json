{
  "name": "gluestackdemo",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test:e2e:android:build": "detox build --configuration android.emu.debug",
    "test:e2e:android:test": "detox test --configuration android.emu.debug",
    "test:e2e:android": "npm run test:e2e:android:build && npm run test:e2e:android:test",
    "test:e2e:ios:build": "detox build --configuration ios.sim.debug",
    "test:e2e:ios:test": "detox test --configuration ios.sim.debug",
    "test:e2e:ios": "npm run test:e2e:ios:build && npm run test:e2e:ios:test"
  },
  "dependencies": {
    "@apollo/client": "^3.9.0",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@gluestack-style/react": "^1.0.57",
    "@gluestack-ui/config": "^1.1.20",
    "@gluestack-ui/themed": "^1.1.73",
    "@react-native-aria/dialog": "^0.0.5",
    "@react-native-aria/focus": "^0.2.9",
    "@react-native-aria/interactions": "^0.2.16",
